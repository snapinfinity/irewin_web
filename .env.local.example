# Same Firebase project as the admin dashboard (copy from irewin_dashboard/.env.local).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyACjP8o7oFFWgi1pgOMQR_ytujui8-wV9E
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=irewinjobs-b674b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=irewinjobs-b674b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=irewinjobs-b674b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=96381037704
NEXT_PUBLIC_FIREBASE_APP_ID=1:96381037704:web:63073e5310bda4bcc4033d

# --- Dodo Payments (server only — never prefix these with NEXT_PUBLIC_) ---
# Dodo dashboard with "Live Mode" switched OFF → Developer → API Keys / Webhooks.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode or live_mode. Keys and product ids must come from the same mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Shows the test-card notice on /checkout. Set to false when going live.
NEXT_PUBLIC_DODO_TEST_MODE=true
# One recurring (subscription) product per plan — `npm run dodo:setup` creates them and fills these in.
DODO_SUBSCRIPTION_1W=
DODO_SUBSCRIPTION_3M=
# One-time product for the 1-hour pass (also created by `npm run dodo:setup`).
DODO_PRODUCT_1H=
DODO_PRODUCT_1D=
# Older one-time products. Only needed so payments made before subscriptions are still recognised.
DODO_PRODUCT_1W=
DODO_PRODUCT_3M=
# Optional: public site URL for Dodo's return/cancel links (defaults to the request's origin).
SITE_URL=

# --- Firebase Admin (server only) — lets the payment routes write membership ---
# Local: path to the dashboard's service account key. Vercel: paste the whole JSON on one line instead.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=../irewin_dashboard/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Welcome email (Resend, server only) ---
# resend.com → API Keys (Sending access). EMAIL_FROM must use a domain verified in Resend → Domains.
RESEND_API_KEY=
EMAIL_FROM=IREWIN Jobs <welcome@irewinjobs.com>
# Optional: where replies go.
EMAIL_REPLY_TO=irewinjobs@gmail.com
